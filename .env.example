# ============================================================
# Configuración del proyecto (NO subir a GitHub; ver .gitignore)
# Pega tus valores sin comillas y sin espacios alrededor del "=".
# ============================================================

# --- Claves y contacto ---------------------------------------
# API key de Scopus/Elsevier (https://dev.elsevier.com)
ELSEVIER_API_KEY=
# Token institucional de Elsevier (opcional; déjalo vacío si no tienes)
ELSEVIER_INST_TOKEN=
# Tu correo institucional (lo piden Unpaywall y OpenAlex)
CONTACT_EMAIL=
# API key de Semantic Scholar (opcional; déjalo vacío)
SEMANTIC_SCHOLAR_API_KEY=

# --- Paso 1: scopus_prisma_multisearch.py --------------------
START_YEAR=2019
# Máximo de registros por búsqueda (vacío = todos)
MAX_RESULTS_PER_SEARCH=100
# true = solo artículos Open Access
OPEN_ACCESS_ONLY=false
# Filtros de la query de Scopus
EXTRA_FILTERS=DOCTYPE(ar) AND SRCTYPE(j) AND LANGUAGE(english) AND SUBJAREA(COMP)
# Filtro por cuartil con el CSV de SCImago (opcional)
SJR_FILE=scimagojr.csv
ONLY_Q1_Q2=false
# Intentar bajar PDFs por la API de Elsevier (casi siempre falla sin token institucional)
DOWNLOAD_ELSEVIER_PDF=false

# --- Paso 2: descarga_pdf_v2.py ------------------------------
# Para pruebas: procesar solo N filas (vacío = todas)
MAX_ROWS=
MAX_CANDIDATES=8
SAVE_EVERY=10

# --- Paso 3: extraer_brechas.py ------------------------------
# Para pruebas: procesar solo N PDFs (vacío = todos)
MAX_PDFS=
MAX_PER_CATEGORY_PER_PAPER=6
MAX_SNIPPET_CHARS=700
